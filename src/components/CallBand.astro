---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Drip, clog, or something worse?',
  text = "Give Amber a call. She'll help figure out what you need and get the right plumber out to you, ready to fix it.",
} = Astro.props;
---

<section class="band-wrap wrap" data-reveal>
  <div class="band">
    <svg class="band__drops" viewBox="0 0 200 200" aria-hidden="true">
      <path d="M60 20c14 16 24 29 24 41a24 24 0 0 1-48 0c0-12 10-25 24-41Z" fill="rgb(255 255 255 / .14)"></path>
      <path d="M150 90c9 10 15 18 15 26a15 15 0 0 1-30 0c0-8 6-16 15-26Z" fill="rgb(255 255 255 / .18)"></path>
      <path d="M95 140c6 7 10 12 10 17a10 10 0 0 1-20 0c0-5 4-10 10-17Z" fill="rgb(255 255 255 / .22)"></path>
    </svg>
    <div class="band__text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="band__actions">
      {
        site.phones.map((p, i) => (
          <a class:list={['btn', i === 0 ? '' : 'btn--white']} href={p.href}>
            <Icon name="phone" size={20} />
            {p.display}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .band-wrap {
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  .band {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem 2.5rem;
    padding: clamp(1.75rem, 5vw, 3.25rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--sky) 0%, var(--sky-700) 100%);
    color: #fff;
    border: 2px solid var(--ink);
    box-shadow: 0 6px 0 var(--ink);
  }
  .band h2 {
    margin-bottom: 0.35em;
  }
  .band p {
    margin: 0;
    max-width: 38rem;
    color: rgb(255 255 255 / 0.9);
    font-size: 1.1rem;
  }
  .band__actions {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    position: relative;
  }
  .band__text {
    position: relative;
  }
  .band__drops {
    position: absolute;
    right: -2rem;
    top: -2rem;
    width: 16rem;
    height: 16rem;
    pointer-events: none;
  }
  @media (max-width: 760px) {
    .band {
      grid-template-columns: 1fr;
    }
    .band__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .band__actions .btn {
      flex: 1 1 12rem;
    }
  }
</style>
