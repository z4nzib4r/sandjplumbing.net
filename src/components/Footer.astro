---
import { url } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <svg class="wave" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 30c120-20 240-20 360 0s240 20 360 0 240-20 360 0 240 20 360 0v30H0Z"
      fill="var(--ink)"></path>
  </svg>
  <div class="footer__body">
    <div class="wrap footer__grid">
      <div class="footer__brand">
        <Logo light />
        <p class="script footer__tag">{site.tagline}</p>
        <p>
          Locally owned, family-run plumbing in Athens County. Master Plumber License {site.license}.
          Fully licensed &amp; insured.
        </p>
      </div>

      <div>
        <h3>Call us</h3>
        <ul>
          {
            site.phones.map((p) => (
              <li>
                <a href={p.href}>
                  <Icon name="phone" size={18} /> {p.display}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3>Find us</h3>
        <ul>
          <li>
            <a href={site.mapUrl} target="_blank" rel="noopener">
              <Icon name="pin" size={18} />
              <span>{site.address.street}<br />{site.address.city}, {site.address.state} {site.address.zip}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="mail" size={18} /> {site.email}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3>Explore</h3>
        <ul>
          <li><a href={url("/services/")}>Services</a></li>
          <li><a href={url("/about/")}>About us</a></li>
          <li><a href={url("/contact/")}>Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer__legal">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>Proudly plumbing Athens, Ohio since {site.founded}.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
  }
  .footer .wave {
    margin-bottom: -1px;
  }
  .footer__body {
    background: var(--ink);
    color: rgb(255 255 255 / 0.78);
    padding-block: 2.5rem 1.5rem;
    padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .footer__tag {
    font-size: 1.7rem;
    color: var(--sky);
    margin: 0.75rem 0 0.25rem;
  }
  .footer h3 {
    color: #fff;
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }
  .footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .footer a {
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    display: inline-flex;
    gap: 0.5rem;
    align-items: flex-start;
    overflow-wrap: anywhere;
  }
  .footer a :global(svg) {
    flex-shrink: 0;
    margin-top: 0.25rem;
    color: var(--sky);
  }
  .footer a:hover {
    color: var(--sun);
  }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.55);
  }
  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
