---
import { url } from '../lib/url';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CallBand from '../components/CallBand.astro';
import Testimonials from '../components/Testimonials.astro';
import { site, services, yearsInBusiness } from '../data/site';
import heroImg from '../assets/hero-cat-faucet.jpg';
import amberImg from '../assets/amber-desk.jpg';

const perks = [
  { icon: 'clock', title: `${yearsInBusiness}+ years`, text: 'Serving Athens since 1994' },
  { icon: 'family', title: 'Family owned', text: 'Locally owned & operated' },
  { icon: 'shield', title: 'Licensed & insured', text: `Master Plumber ${site.license}` },
  { icon: 'building', title: 'Home & business', text: 'Residential & commercial' },
] as const;

const featured = services.slice(1, 7);
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__script script">{site.tagline}</p>
        <h1>
          Athens' family plumbers, <span class="hero__hl">ready to help.</span>
        </h1>
        <p class="lead">
          Locally owned and operated for {yearsInBusiness}+ years. From a dripping faucet to complete new plumbing in your
          commercial building, we stand by our work.
        </p>
        <div class="hero__ctas">
          <a class="btn" href={site.phones[0].href}>
            <Icon name="phone" size={20} /> Call {site.phones[0].display}
          </a>
          <a class="btn btn--ghost" href={url("/services/")}>
            See our services <Icon name="arrow" size={20} />
          </a>
        </div>
      </div>

      <div class="hero__art">
        <div class="hero__photo">
          <Image
            src={heroImg}
            alt="A curious cat reaching up to a dripping kitchen faucet"
            widths={[480, 720, 960, 1200]}
            sizes="(max-width: 900px) 92vw, 560px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero__bubble" aria-hidden="true">
          Drip… drip…<br /><strong>call S&amp;J!</strong>
        </div>
        <div class="hero__badge">
          <span class="hero__badge-num">{yearsInBusiness}+</span>
          <span>years in<br />business</span>
        </div>
        <svg class="hero__wrench" viewBox="0 0 61 227" aria-hidden="true">
          <path
            d="M30.5 0C43 4 54 12 58 26c4 14-1 27-12 35l-4 3v150c0 7-5 13-11.5 13S19 221 19 214V64l-4-3C4 53-1 40 3 26 7 12 18 4 30.5 0l-8 18 8 14 8-14Z"
            fill="var(--wrench)"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- PERKS -->
  <section class="wrap perks-wrap">
    <ul class="perks">
      {
        perks.map((p) => (
          <li data-reveal>
            <span class="perks__icon">
              <Icon name={p.icon} size={26} />
            </span>
            <span>
              <strong>{p.title}</strong>
              <small>{p.text}</small>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- WELCOME -->
  <section class="section">
    <div class="wrap welcome">
      <div class="welcome__photo" data-reveal>
        <Image
          src={amberImg}
          alt="Co-owner Amber Brown at her desk in an S&J Plumbing shirt"
          widths={[400, 640, 900]}
          sizes="(max-width: 860px) 92vw, 480px"
        />
        <div class="welcome__note">
          <span class="script">Hi, I'm Amber!</span>
          <small>Co-owner · 15+ years experience</small>
        </div>
      </div>
      <div data-reveal>
        <span class="eyebrow"><Icon name="drop" size={16} /> Welcome</span>
        <h2>One call, and we'll show up prepared.</h2>
        <p>
          Give co-owner <strong>Amber Brown</strong> a call. With her 15+ years of experience she'll help you work out what
          your plumbing needs are and schedule an appointment, so our plumbers arrive with the right parts and the right
          plan.
        </p>
        <p>
          We're a fully licensed and insured company that stands by our work. Our customers range from homeowners and
          landlords to business owners, and <strong>every customer is treated equally.</strong>
        </p>
        <div class="callout">
          <span class="callout__icon"><Icon name="house" size={22} /></span>
          <p>
            <strong>Live out of state?</strong> If you own property in our service area, we're happy to help. We can contact
            your tenants to schedule an appointment and send the bill straight to you.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- NOT A HANDYMAN -->
  <section class="ribbon">
    <div class="wrap ribbon__inner" data-reveal>
      <p>
        We're not a handyman service.<br />
        We're a professional <span class="ribbon__big">plumbing company!</span>
      </p>
    </div>
  </section>

  <!-- SERVICES PREVIEW -->
  <section class="section">
    <div class="wrap">
      <div class="svc-head" data-reveal>
        <div>
          <span class="eyebrow"><Icon name="wrench" size={16} /> What we do</span>
          <h2>Full-service plumbing</h2>
        </div>
        <a class="btn btn--sky" href={url("/services/")}>All services <Icon name="arrow" size={20} /></a>
      </div>
      <ul class="svc-grid">
        {
          featured.map((s) => (
            <li class="svc card" data-reveal>
              <span class="svc__icon">
                <Icon name={s.icon} size={28} />
              </span>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- US 50 -->
  <section class="wrap news-wrap">
    <div class="news" data-reveal>
      <span class="news__pill">News</span>
      <div>
        <h2>US 50 Sanitary Sewer Project</h2>
        <p>
          We're partnering with other local professionals to install new sewage line connections for the US 50 Sanitary
          Sewer Project. You get professional work that's cost effective and done right the first time, without the
          headache of managing it yourself. <strong>Peace of mind is priceless!</strong>
        </p>
      </div>
      <a class="btn btn--white" href={url("/contact/")}>Ask about it <Icon name="arrow" size={20} /></a>
    </div>
  </section>

  <Testimonials />

  <CallBand />
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 8vw, 6rem);
    background:
      radial-gradient(60rem 30rem at 85% 10%, var(--sky-100), transparent 60%),
      radial-gradient(40rem 24rem at 0% 100%, var(--sun-200), transparent 60%);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .hero__script {
    font-size: clamp(1.7rem, 3.5vw, 2.3rem);
    margin: 0 0 0.25rem;
    transform: rotate(-3deg);
    transform-origin: left;
  }
  .hero h1 {
    margin-bottom: 0.4em;
  }
  .hero__hl {
    position: relative;
    color: var(--sky-700);
    white-space: nowrap;
  }
  .hero__hl::after {
    content: '';
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    bottom: 0.02em;
    height: 0.32em;
    background: var(--sun);
    border-radius: 999px;
    z-index: -1;
    opacity: 0.75;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .hero__art {
    position: relative;
    max-width: 36rem;
    justify-self: center;
    width: 100%;
  }
  .hero__photo {
    border-radius: 2.5rem 2.5rem 2.5rem 0.75rem;
    overflow: hidden;
    border: 3px solid var(--ink);
    box-shadow: 10px 10px 0 var(--sky);
    aspect-ratio: 4 / 3.4;
    transform: rotate(1.5deg);
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }
  .hero__bubble {
    position: absolute;
    top: -1.25rem;
    left: -1.5rem;
    padding: 0.85rem 1.3rem;
    background: var(--sun);
    border: 2px solid var(--ink);
    border-radius: 1.5rem;
    box-shadow: 0 4px 0 var(--ink);
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.2;
    transform: rotate(-6deg);
    animation: bob 4s ease-in-out infinite;
  }
  .hero__bubble::after {
    content: '';
    position: absolute;
    bottom: -0.85rem;
    right: 1.75rem;
    width: 1.3rem;
    height: 1.3rem;
    background: var(--sun);
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: skewX(20deg) rotate(45deg);
    clip-path: polygon(100% 0, 100% 100%, 0 100%);
  }
  .hero__badge {
    position: absolute;
    right: -0.75rem;
    bottom: -1.5rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.1rem;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 1.25rem;
    box-shadow: 0 4px 0 var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    line-height: 1.1;
  }
  .hero__badge-num {
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--sky-600);
  }
  .hero__wrench {
    position: absolute;
    width: 2.6rem;
    left: -2.25rem;
    bottom: -1rem;
    transform: rotate(-28deg);
    filter: drop-shadow(3px 3px 0 var(--ink));
  }
  @keyframes bob {
    0%,
    100% {
      transform: rotate(-6deg) translateY(0);
    }
    50% {
      transform: rotate(-4deg) translateY(-6px);
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__art {
      max-width: 30rem;
      margin-top: 1rem;
      padding-inline: 0.75rem;
    }
    .hero__bubble {
      left: 0;
    }
    .hero__badge {
      right: 0.5rem;
    }
    .hero__wrench {
      display: none;
    }
  }

  /* PERKS */
  .perks-wrap {
    margin-top: clamp(-2rem, -3vw, -1rem);
    position: relative;
    z-index: 2;
  }
  .perks {
    list-style: none;
    margin: 0;
    padding: 1.25rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: 0 5px 0 var(--ink);
  }
  .perks li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem;
  }
  .perks strong {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .perks small {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }
  .perks__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 1rem;
    background: var(--sky-50);
    color: var(--sky-700);
  }
  @media (max-width: 900px) {
    .perks-wrap {
      margin-top: 1.5rem;
    }
    .perks {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 460px) {
    .perks {
      grid-template-columns: 1fr;
      padding: 0.9rem;
    }
  }

  /* WELCOME */
  .welcome {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
  }
  .welcome__photo {
    position: relative;
  }
  .welcome__photo img {
    border-radius: var(--radius-lg);
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    object-position: 75% 30%;
    width: 100%;
    border: 3px solid var(--ink);
    box-shadow: -10px 10px 0 var(--sun);
  }
  .welcome__note {
    position: absolute;
    left: 50%;
    bottom: -1.5rem;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.5rem 1.4rem 0.6rem;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 1.25rem;
    box-shadow: 0 4px 0 var(--ink);
    white-space: nowrap;
  }
  .welcome__note .script {
    font-size: 1.9rem;
    line-height: 1;
  }
  .welcome__note small {
    color: var(--ink-soft);
    font-weight: 700;
    font-size: 0.8rem;
  }
  .callout {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-top: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--sky-50);
    border: 1px dashed var(--sky);
  }
  .callout p {
    margin: 0;
  }
  .callout__icon {
    flex-shrink: 0;
    color: var(--sky-700);
    margin-top: 0.15rem;
  }
  @media (max-width: 860px) {
    .welcome {
      grid-template-columns: 1fr;
    }
    .welcome__photo {
      max-width: 28rem;
      margin-inline: auto;
      width: 100%;
      margin-bottom: 1.5rem;
    }
  }

  /* RIBBON */
  .ribbon {
    background: var(--ink);
    color: #fff;
    transform: rotate(-1.5deg);
    margin-block: 1rem;
    margin-inline: -5vw;
    padding-inline: 5vw;
    border-block: 4px solid var(--sun);
  }
  .ribbon__inner {
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
  }
  .ribbon p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
  }
  .ribbon__big {
    color: var(--sun);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  /* SERVICES */
  .svc-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
    margin-bottom: 2.25rem;
  }
  .svc-head h2 {
    margin: 0;
  }
  .svc-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.25rem;
  }
  .svc {
    padding: 1.6rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .svc:hover {
    transform: translateY(-4px);
    border-color: var(--sky);
    box-shadow: 0 14px 30px -14px rgb(0 125 159 / 0.45);
  }
  .svc h3 {
    margin: 1rem 0 0.4rem;
  }
  .svc p {
    margin: 0;
    color: var(--ink-soft);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 1.1rem;
    background: var(--sky);
    color: #fff;
    transition: transform 0.25s ease;
  }
  .svc:hover .svc__icon {
    transform: rotate(-8deg) scale(1.06);
  }
  .svc:nth-child(3n + 2) .svc__icon {
    background: var(--sun);
    color: var(--ink);
  }
  .svc:nth-child(3n + 3) .svc__icon {
    background: var(--ink);
  }

  /* NEWS */
  .news-wrap {
    padding-bottom: clamp(3.5rem, 9vw, 6rem);
  }
  .news {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem 2rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--sun-200);
    border: 2px solid var(--ink);
  }
  .news h2 {
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin-bottom: 0.4em;
  }
  .news p {
    margin: 0;
  }
  .news__pill {
    align-self: start;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--wrench);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (max-width: 760px) {
    .news {
      grid-template-columns: 1fr;
    }
    .news__pill {
      justify-self: start;
    }
    .news .btn {
      justify-self: start;
    }
  }
</style>
