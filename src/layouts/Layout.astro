---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, services } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title,
  description = 'Locally owned, family-run plumbing company in Athens, Ohio for 25+ years. Water heaters, drain cleaning, gas lines, water lines and more. Licensed & insured.',
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name} · Athens, Ohio` : `${site.name} | Plumbing Contractor in Athens, Ohio`;
const canonical = new URL(Astro.url.pathname, site.url);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phones.map((p) => p.href.replace('tel:', '')),
  foundingDate: String(site.founded),
  slogan: site.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: 'US',
  },
  areaServed: 'Athens County, Ohio',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Plumbing services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title },
    })),
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#00b9e8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main {
    overflow-x: clip;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--sun);
    color: var(--ink);
    border-radius: 0.5rem;
    font-weight: 700;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
